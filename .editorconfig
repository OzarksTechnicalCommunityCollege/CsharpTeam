root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
# C# naming conventions
dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = camel_case_underscore_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.camel_case_underscore_style.required_prefix = _
dotnet_naming_style.camel_case_underscore_style.capitalization = camel_case

# Simplify code style
dotnet_style_var_for_built_in_types = false:suggestion
dotnet_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Null checking preferences
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion

# Unnecessary code
dotnet_diagnostic.IDE0051.severity = warning  # unused private member
dotnet_diagnostic.IDE0052.severity = warning  # unread private member
dotnet_diagnostic.IDE0060.severity = warning  # unused parameter

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
